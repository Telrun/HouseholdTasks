@inject NavigationManager Nav

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div style="padding:2rem;font-family:sans-serif;">
                        <p>You need to sign in to view this page.</p>
                        <button class="btn btn-primary" @onclick="SignIn">Sign in with Google</button>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <div style="padding:2rem;font-family:sans-serif;">
                <p>Sorry, there's nothing at this address.</p>
            </div>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // A plain <a href> gets intercepted by Blazor's client-side router (it tries to resolve
    // "api/account/login" as a SPA route, which doesn't exist, and shows NotFound instead of
    // letting the browser make a real request). forceLoad: true bypasses the router and does
    // an actual full-page navigation, so the request reaches the server and triggers the
    // Google OAuth challenge redirect.
    private void SignIn() =>
        Nav.NavigateTo($"api/account/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
}
