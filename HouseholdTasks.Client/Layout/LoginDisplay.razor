@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <span style="color:white;margin-right:0.75rem;">
            @context.User.Identity?.Name
            @if (context.User.IsInRole("Admin"))
            {
                <span> (admin)</span>
            }
        </span>

        <button class="btn-secondary" @onclick="LogOut">
            Logg ut
        </button>
    </Authorized>

    <NotAuthorized>
        <button class="btn btn-secondary" @onclick="SignIn">
            Logg inn med Google
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string LoginUrl =>
        $"{Nav.BaseUri}api/account/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}";

    private void SignIn()
    {
        Nav.NavigateTo(LoginUrl, forceLoad: true);
    }

    private async Task LogOut()
    {
        await Http.PostAsync("api/account/logout", null);

        ((CookieAuthenticationStateProvider)AuthProvider)
            .NotifyUserChanged();

        Nav.NavigateTo(Nav.BaseUri, forceLoad: true);
    }
}