@page "/my-tasks"
@attribute [Authorize]
@inject HttpClient Http
@inject NotificationService Notifications
@implements IAsyncDisposable

<h1>My Tasks</h1>

@if (_foregroundToastTitle is not null)
{
    <div class="toast-notification">
        <div>
            <strong>@_foregroundToastTitle</strong>
            @if (!string.IsNullOrWhiteSpace(_foregroundToastBody))
            {
                <div>@_foregroundToastBody</div>
            }
        </div>
        <button class="btn-secondary" @onclick="DismissToast">✕</button>
    </div>
}

@if (_notificationStatus is PushNotificationStatus.NotRequested)
{
    <div class="notify-banner">
        <span>🔔 Vil du få varsel når du får en ny oppgave, eller når det blir din tur?</span>
        <button class="btn-primary" @onclick="EnableNotificationsAsync">Aktiver varsler</button>
    </div>
}
else if (_notificationStatus is PushNotificationStatus.IosNeedsInstall)
{
    <div class="notify-banner">
        <span>
            🔔 For å få varsler på iPhone må du først legge appen til på hjemskjermen:
            trykk «Del»-knappen i Safari, deretter «Legg til på Hjem-skjerm». Åpne appen
            derfra for å aktivere varsler.
        </span>
    </div>
}
else if (_notificationStatus is PushNotificationStatus.Denied)
{
    <div class="notify-banner">
        <span>🔕 Varsler er blokkert for denne enheten. Du kan endre dette i nettleserinnstillingene.</span>
    </div>
}

<label for="datePicker">Dato</label>
<input id="datePicker" type="date" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" style="max-width:220px;" />
<button class="btn-secondary" style="margin-left:0.5rem;" @onclick="GoToToday">I dag</button>

@if (_tasks is null)
{
    <p>laster…</p>
}
else if (_tasks.Count == 0)
{
    <p>Du har ingen oppgaver i dag.</p>
}
else
{
    <div style="margin-top:1rem;">
        @foreach (var task in _tasks)
        {
            <div class="task-card @(task.IsCompleted ? "completed" : "")">
                <div>
                    <span class="category-pill">@task.Category</span>
                    <div class="title">@task.Title</div>
                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        <div class="meta">@task.Description</div>
                    }
                    <div class="meta">
                        @if (task.IsRotating)
                        {
                            <text>Din tur denne runden — rotasjon: @string.Join(" → ", task.AssignedFamilyMemberNames)</text>
                        }
                        else
                        {
                            <text>Med: @string.Join(", ", task.AssignedFamilyMemberNames)</text>
                        }
                    </div>
                    @if (task.DueTime != new TimeOnly(23, 59))
                    {
                        <div class="meta">⏰ Frist: kl. @task.DueTime.ToString("HH:mm")</div>
                    }
                    @if (task.Recurrence != RecurrenceType.None)
                    {
                        <div class="meta">🔁 Repeats @task.Recurrence.ToString().ToLower()</div>
                    }
                </div>
                <div>
                    @if (task.IsCompleted)
                    {
                        <span>✅ Ferdig</span>
                    }
                    else
                    {
                        <button class="btn-primary" @onclick="() => CompleteAsync(task.Id)">Marker som utført</button>
                    }
                </div>
            </div>
        }
    </div>
}

<hr style="margin:2rem 0;" />

<button class="btn-secondary" @onclick="() => _showAddTaskForm = !_showAddTaskForm">
    @(_showAddTaskForm ? "▾" : "▸") Legg til en oppgave
</button>

@if (_showAddTaskForm)
{
    <div style="margin-top:1rem;">
        <EditForm Model="_newTask" OnValidSubmit="AddTaskAsync">
            <label>Tittel</label>
            <input @bind="_newTask.Title" />

            <label>Beskrivelse</label>
            <textarea @bind="_newTask.Description"></textarea>

            <label>Kategori</label>
            <select @bind="_newTask.Category">
                @foreach (var cat in Enum.GetValues<TaskCategory>())
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <label>Utføres innen</label>
            <div style="display:flex;gap:0.5rem;">
                <input type="date" value="@_newTask.DueDate.ToString("yyyy-MM-dd")"
                       @onchange="e => _newTask.DueDate = DateOnly.Parse((string)e.Value!)" />
                <input type="time" value="@_newTask.DueTime.ToString("HH:mm")"
                       @onchange="e => _newTask.DueTime = TimeOnly.Parse((string)e.Value!)"
                       style="max-width:130px;" />
            </div>

            <label>Gjentas</label>
            <select @bind="_newTask.Recurrence">
                <option value="@RecurrenceType.None">Gjentas ikke</option>
                <option value="@RecurrenceType.Daily">Daglig</option>
                <option value="@RecurrenceType.Weekly">Ukentlig</option>
                <option value="@RecurrenceType.Monthly">Månedlig</option>
            </select>

            <label>Oppgave tildelt</label>
            @if (_familyMembers is not null)
            {
                @foreach (var member in _familyMembers)
                {
                    <label style="font-weight:normal;">
                        <input type="checkbox" style="width:auto;display:inline;"
                               checked="@_newTask.AssignedFamilyMemberIds.Contains(member.Id)"
                               @onchange="e => ToggleAssignee(member.Id, (bool)e.Value!)" />
                        @member.Name
                    </label>
                }
            }

            @if (_newTask.Recurrence != RecurrenceType.None && _newTask.AssignedFamilyMemberIds.Count > 1)
            {
                <label>Delingsmåte</label>
                <select @bind="_newTask.AssignmentMode">
                    <option value="@TaskAssignmentMode.Shared">Alle deler oppgaven (hvem som helst kan gjøre den)</option>
                    <option value="@TaskAssignmentMode.Rotating">Rundgang (bytter person for hver runde)</option>
                </select>
                @if (_newTask.AssignmentMode == TaskAssignmentMode.Rotating)
                {
                    <p class="meta">
                        @string.Join(" → ", _newTask.AssignedFamilyMemberIds
                            .Select(id => _familyMembers?.FirstOrDefault(m => m.Id == id)?.Name ?? "?"))
                        — starter med den første, bytter til neste hver gang den fullføres.
                    </p>
                }
            }

            <button type="submit" class="btn-primary" style="margin-top:1rem;">Legg til oppgave</button>
        </EditForm>
    </div>
}

@code {
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private List<HouseholdTaskDto>? _tasks;
    private List<FamilyMemberDto>? _familyMembers;
    private CreateHouseholdTaskDto _newTask = new() { DueDate = DateOnly.FromDateTime(DateTime.Now) };
    private bool _showAddTaskForm;

    private PushNotificationStatus? _notificationStatus;
    private string? _foregroundToastTitle;
    private string? _foregroundToastBody;

    protected override async Task OnInitializedAsync()
    {
        _familyMembers = await Http.GetFromJsonAsync<List<FamilyMemberDto>>("api/family-members");
        await LoadTasksAsync();

        _notificationStatus = await Notifications.GetStatusAsync();
        if (_notificationStatus == PushNotificationStatus.Granted)
        {
            // Already granted on a previous visit — just (re)start listening for
            // foreground pushes. No need to re-request permission or re-register the
            // token; the server already has it from last time (tokens are stable unless
            // the user clears site data or reinstalls).
            Notifications.ForegroundNotificationReceived += OnForegroundToast;
            await Notifications.StartListeningForForegroundMessagesAsync();
        }
    }

    private async Task EnableNotificationsAsync()
    {
        var token = await Notifications.RequestPermissionAndGetTokenAsync();
        if (token is null)
        {
            _notificationStatus = await Notifications.GetStatusAsync();
            return;
        }

        await Http.PostAsJsonAsync("api/notifications/register-token", new { Token = token, Platform = "web" });

        _notificationStatus = PushNotificationStatus.Granted;
        Notifications.ForegroundNotificationReceived += OnForegroundToast;
        await Notifications.StartListeningForForegroundMessagesAsync();
    }

    private void OnForegroundToast(string title, string body)
    {
        _foregroundToastTitle = title;
        _foregroundToastBody = body;
        InvokeAsync(StateHasChanged);
    }

    private void DismissToast()
    {
        _foregroundToastTitle = null;
        _foregroundToastBody = null;
    }

    public ValueTask DisposeAsync()
    {
        Notifications.ForegroundNotificationReceived -= OnForegroundToast;
        return ValueTask.CompletedTask;
    }

    private async Task LoadTasksAsync()
    {
        _tasks = await Http.GetFromJsonAsync<List<HouseholdTaskDto>>(
            $"api/tasks?date={_selectedDate:yyyy-MM-dd}&mine=true");
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse((string?)e.Value, out var parsed))
        {
            _selectedDate = parsed;
            await LoadTasksAsync();
        }
    }

    private async Task GoToToday()
    {
        _selectedDate = DateOnly.FromDateTime(DateTime.Now);
        await LoadTasksAsync();
    }

    private async Task CompleteAsync(int taskId)
    {
        await Http.PostAsync($"api/tasks/{taskId}/complete", null);
        await LoadTasksAsync();
    }

    private void ToggleAssignee(int memberId, bool isChecked)
    {
        if (isChecked && !_newTask.AssignedFamilyMemberIds.Contains(memberId))
            _newTask.AssignedFamilyMemberIds.Add(memberId);
        else if (!isChecked)
            _newTask.AssignedFamilyMemberIds.Remove(memberId);
    }

    private async Task AddTaskAsync()
    {
        var response = await Http.PostAsJsonAsync("api/tasks", _newTask);
        if (response.IsSuccessStatusCode)
        {
            _newTask = new CreateHouseholdTaskDto { DueDate = _selectedDate };
            _showAddTaskForm = false;
            await LoadTasksAsync();
        }
    }
}
