@page "/admin"
@attribute [Authorize(Policy = "AdminOnly")]
@inject HttpClient Http

<h1>Admin — Oppgaveoversikt</h1>

<label>Dato</label>
<input type="date" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" style="max-width:220px;" />

@if (_tasks is null)
{
    <p>Laster…</p>
}
else if (_tasks.Count == 0)
{
    <p>Ingen oppgaver denne dagen.</p>
}
else
{
    <div style="margin-top:1rem;">
        @foreach (var task in _tasks)
        {
            @if (_editingTaskId == task.Id)
            {
                <div class="task-card">
                    <EditForm Model="_editTask" OnValidSubmit="() => SaveTaskAsync(task.Id)" style="width:100%;">
                        <label>Tittel</label>
                        <input @bind="_editTask.Title" />

                        <label>Beskrivelse</label>
                        <textarea @bind="_editTask.Description"></textarea>

                        <label>Kategori</label>
                        <select @bind="_editTask.Category">
                            @foreach (var cat in Enum.GetValues<TaskCategory>())
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>

                        <label>Utføres innen</label>
                        <div style="display:flex;gap:0.5rem;">
                            <input type="date" value="@_editTask.DueDate.ToString("yyyy-MM-dd")"
                                   @onchange="e => _editTask.DueDate = DateOnly.Parse((string)e.Value!)" />
                            <input type="time" value="@_editTask.DueTime.ToString("HH:mm")"
                                   @onchange="e => _editTask.DueTime = TimeOnly.Parse((string)e.Value!)"
                                   style="max-width:130px;" />
                        </div>

                        <label>Gjentas</label>
                        <select @bind="_editTask.Recurrence">
                            <option value="@RecurrenceType.None">Gjentas ikke</option>
                            <option value="@RecurrenceType.Daily">Daglig</option>
                            <option value="@RecurrenceType.Weekly">Ukentlig</option>
                            <option value="@RecurrenceType.Monthly">Månedlig</option>
                        </select>

                        <label>Oppgave tildelt</label>
                        @if (_familyMembers is not null)
                        {
                            @foreach (var member in _familyMembers)
                            {
                                <label style="font-weight:normal;">
                                    <input type="checkbox" style="width:auto;display:inline;"
                                           checked="@_editTask.AssignedFamilyMemberIds.Contains(member.Id)"
                                           @onchange="e => ToggleEditAssignee(member.Id, (bool)e.Value!)" />
                                    @member.Name
                                </label>
                            }
                        }

                        <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                            <button type="submit" class="btn-primary">Lagre</button>
                            <button type="button" class="btn-secondary" @onclick="CancelEditTask">Avbryt</button>
                        </div>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="task-card @(task.IsCompleted ? "completed" : "") @(task.IsOverdue ? "overdue" : "")">
                    <div>
                        <span class="category-pill">@task.Category</span>
                        <div class="title">@task.Title</div>
                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <div class="meta">@task.Description</div>
                        }
                        <div class="meta">
                            Tildelt: @(task.AssignedFamilyMemberNames.Count > 0
                                ? string.Join(", ", task.AssignedFamilyMemberNames)
                                : "Ikke tildelt")
                        </div>
                        @if (task.IsCompleted)
                        {
                            <div class="meta">Utført av @task.CompletedByName</div>
                        }
                        @if (task.DueTime != new TimeOnly(23, 59))
                        {
                            <div class="meta">⏰ Frist: kl. @task.DueTime.ToString("HH:mm")</div>
                        }
                        @if (task.Recurrence != RecurrenceType.None)
                        {
                            <div class="meta">🔁 Gjentas @task.Recurrence.ToString().ToLower()</div>
                        }
                    </div>
                    <div style="display:flex;gap:0.5rem;">
                        <button class="btn-secondary" @onclick="() => StartEditTask(task)">Rediger</button>
                        @if (task.IsCompleted)
                        {
                            <button class="btn-secondary" @onclick="() => ResetAsync(task.Id)">Reset</button>
                        }
                        <button class="btn-danger" @onclick="() => DeleteAsync(task.Id)">Slett</button>
                    </div>
                </div>
            }
        }
    </div>
}

<hr style="margin:2rem 0;" />

<h2>Familiemedlemmer</h2>

@if (_familyMembers is null)
{
    <p>Laster…</p>
}
else
{
    <div>
        @foreach (var member in _familyMembers)
        {
            @if (_editingMemberId == member.Id)
            {
                <div class="task-card">
                    <EditForm Model="_editMember" OnValidSubmit="() => SaveMemberAsync(member.Id)" style="width:100%;">
                        <label>Navn</label>
                        <input @bind="_editMember.Name" />

                        <label style="font-weight:normal;">
                            <input type="checkbox" style="width:auto;display:inline;" @bind="_editMember.IsAdmin" />
                            Administrator
                        </label>

                        <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                            <button type="submit" class="btn-primary">Lagre</button>
                            <button type="button" class="btn-secondary" @onclick="CancelEditMember">Avbryt</button>
                        </div>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="task-card">
                    <div>
                        <div class="title">@member.Name @(member.IsAdmin ? "⭐" : "")</div>
                        <div class="meta">@member.Email</div>
                    </div>
                    <button class="btn-secondary" @onclick="() => StartEditMember(member)">Rediger</button>
                </div>
            }
        }
    </div>
}

@code {
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private List<HouseholdTaskDto>? _tasks;
    private List<FamilyMemberDto>? _familyMembers;

    private int? _editingTaskId;
    private CreateHouseholdTaskDto _editTask = new();

    private int? _editingMemberId;
    private CreateFamilyMemberDto _editMember = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
        await LoadMembersAsync();
    }

    private async Task LoadTasksAsync()
    {
        _tasks = await Http.GetFromJsonAsync<List<HouseholdTaskDto>>($"api/tasks?date={_selectedDate:yyyy-MM-dd}");
    }

    private async Task LoadMembersAsync()
    {
        _familyMembers = await Http.GetFromJsonAsync<List<FamilyMemberDto>>("api/family-members");
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse((string?)e.Value, out var parsed))
        {
            _selectedDate = parsed;
            await LoadTasksAsync();
        }
    }

    private async Task ResetAsync(int taskId)
    {
        await Http.PostAsync($"api/tasks/{taskId}/reset", null);
        await LoadTasksAsync();
    }

    private async Task DeleteAsync(int taskId)
    {
        await Http.DeleteAsync($"api/tasks/{taskId}");
        await LoadTasksAsync();
    }

    private void StartEditTask(HouseholdTaskDto task)
    {
        _editingTaskId = task.Id;
        _editTask = new CreateHouseholdTaskDto
        {
            Title = task.Title,
            Description = task.Description,
            Category = task.Category,
            DueDate = task.DueDate,
            DueTime = task.DueTime,
            Recurrence = task.Recurrence,
            AssignedFamilyMemberIds = new List<int>(task.AssignedFamilyMemberIds)
        };
    }

    private void CancelEditTask() => _editingTaskId = null;

    private void ToggleEditAssignee(int memberId, bool isChecked)
    {
        if (isChecked && !_editTask.AssignedFamilyMemberIds.Contains(memberId))
            _editTask.AssignedFamilyMemberIds.Add(memberId);
        else if (!isChecked)
            _editTask.AssignedFamilyMemberIds.Remove(memberId);
    }

    private async Task SaveTaskAsync(int taskId)
    {
        var response = await Http.PutAsJsonAsync($"api/tasks/{taskId}", _editTask);
        if (response.IsSuccessStatusCode)
        {
            _editingTaskId = null;
            await LoadTasksAsync();
        }
    }

    private void StartEditMember(FamilyMemberDto member)
    {
        _editingMemberId = member.Id;
        _editMember = new CreateFamilyMemberDto
        {
            Name = member.Name,
            Email = member.Email,
            IsAdmin = member.IsAdmin
        };
    }

    private void CancelEditMember() => _editingMemberId = null;

    private async Task SaveMemberAsync(int memberId)
    {
        var response = await Http.PutAsJsonAsync($"api/family-members/{memberId}", _editMember);
        if (response.IsSuccessStatusCode)
        {
            _editingMemberId = null;
            await LoadMembersAsync();
        }
    }
}
