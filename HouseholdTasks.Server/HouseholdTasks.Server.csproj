<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>household-tasks-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Microsoft.EntityFrameworkCore.Sqlite still transitively pulls
      SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries a known high-severity
      vulnerability (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q) in the bundled native
      SQLite build. This direct reference to the current bundle overrides that
      transitive version so NuGet resolves the patched native SQLite build instead.
      Remove this once a future Microsoft.EntityFrameworkCore.Sqlite release
      updates its own dependency (tracked at dotnet/efcore#38257).
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HouseholdTasks.Client\HouseholdTasks.Client.csproj" />
    <ProjectReference Include="..\HouseholdTasks.Shared\HouseholdTasks.Shared.csproj" />
  </ItemGroup>

</Project>
